# Porta su cui viene avviato il backend Express
PORT=3000

# URL del frontend React/Vite autorizzato a chiamare il backend
CLIENT_ORIGIN=http://localhost:5173

# Ambiente di esecuzione
NODE_ENV=development

# Stringa di connessione al database MongoDB
# Esempio Atlas: mongodb+srv://utente:password@cluster.mongodb.net/taccat
# Esempio Docker futuro: mongodb://mongo:27017/taccat
MONGODB_URI=your_mongodb_connection_string

# Chiave segreta usata per firmare i token JWT access
JWT_ACCESS_SECRET=your_jwt_access_secret